rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{lead} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /whatsapp_conversations/{phone} {
      allow read, write: if true;
    }
    match /whatsapp_leads/{phone} {
      allow read, write: if true;
    }
  }
}