# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# scripts de desarrollo con tokens (NO versionar)
/ads
scratch_*.js
*.zip

# screenshots de configuración (no versionar)
screencapture-*.png
Screenshot_*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling de skills (npx skills add) y settings locales — NO versionar
/.agents
/.claude/skills
.claude/settings.local.json
skills-lock.json
